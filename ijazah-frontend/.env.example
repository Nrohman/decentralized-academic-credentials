# ==========================================
# IJAZAH-FRONTEND ENVIRONMENT TEMPLATE
# ==========================================

# Pinata IPFS Gateway and API Credentials
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token_here
API_KEY_PINATA=your_pinata_api_key_here
API_SECRET_PINATA=your_pinata_api_secret_here
PINATA_GATEWAY=your-gateway-subdomain.mypinata.cloud

# Smart Contract Address on Polygon Amoy (Layer-2)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Polygon Amoy RPC Endpoint (via Alchemy or Infura)
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Campus Salt for Deterministic Wallet Derivation (Keccak-256)
MASTER_SECRET_CAMPUS=your_institution_secret_salt_here
